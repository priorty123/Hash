<Window x:Class="HashDash.MtpDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Device"
        Width="620"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Connect Device"
                       FontSize="22"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Phones, cameras, and other devices connected via USB. Files are read directly from the device — nothing is written to it."
                       FontSize="12"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Device list -->
        <ListBox Grid.Row="2"
                 x:Name="lstDevices"
                 SelectionMode="Single"
                 SelectionChanged="LstDevices_SelectionChanged"
                 MouseDoubleClick="LstDevices_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,8">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Badge}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#E8A000"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2"
                   x:Name="txtEmptyState"
                   Text="No devices detected. Connect the device via USB, unlock it, allow access on it if prompted, then click Refresh."
                   FontSize="13"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <TextBlock Grid.Row="3"
                   x:Name="txtIosNote"
                   FontSize="12"
                   Foreground="#E8A000"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <!-- Refresh + iOS scope -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Refresh"
                    Width="100"
                    Height="36"
                    Click="BtnRefresh_Click"
                    FontSize="13"/>
            <CheckBox Grid.Column="2"
                      x:Name="chkEntirePartition"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      ToolTip="Also lists Downloads, Voice Memos, Books, thumbnails, caches and other Photos internals.">
                <TextBlock Text="Scan the entire media partition (not just the Photos library)" TextWrapping="Wrap"/>
            </CheckBox>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="120"
                    Height="40"
                    Margin="0,0,12,0"
                    Click="BtnCancel_Click"
                    FontSize="13"/>
            <Button Content="Load Files"
                    x:Name="btnLoad"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="140"
                    Height="40"
                    Click="BtnLoad_Click"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
