<Window x:Class="HashDash.MtpDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect MTP Device"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Connect MTP Device"
                       FontSize="22"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Phones, cameras, and other Portable Devices connected via USB. Files are read directly from the device — nothing is written to it."
                       FontSize="12"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Device list -->
        <ListBox Grid.Row="2"
                 x:Name="lstDevices"
                 SelectionMode="Single"
                 MouseDoubleClick="LstDevices_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,8">
                        <TextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2"
                   x:Name="txtEmptyState"
                   Text="No portable devices detected. Connect the device via USB, allow file access on it if prompted, then click Refresh."
                   FontSize="13"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Refresh -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Refresh"
                    Width="100"
                    Height="36"
                    Click="BtnRefresh_Click"
                    FontSize="13"/>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="120"
                    Height="40"
                    Margin="0,0,12,0"
                    Click="BtnCancel_Click"
                    FontSize="13"/>
            <Button Content="Load Files"
                    x:Name="btnLoad"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="140"
                    Height="40"
                    Click="BtnLoad_Click"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
