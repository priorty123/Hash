<Window x:Class="HashDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HashDash.ViewModels"
         xmlns:local="clr-namespace:HashDash" 
        xmlns:converters="clr-namespace:HashDash.Helpers"
        Title="HashDash"
        MinHeight="800"
        MinWidth="1400"
        Icon="/HashDash.ico"
        WindowState="Maximized"
        FontFamily="Segoe UI Variable"
        AllowDrop="False">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <!-- EXISTING (UNCHANGED) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:StringContainsConverter x:Key="StringContainsConverter"/>
        <converters:StringIsNotEmptyConverter x:Key="StringIsNotEmptyConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <!-- STATUS COLOURS -->
        <SolidColorBrush x:Key="StatusWarningBrush" Color="#E8A000"/>
        <SolidColorBrush x:Key="StatusSuccessBrush" Color="#107C10"/>
        <SolidColorBrush x:Key="StatusErrorBrush"   Color="#C42B1C"/>
        <SolidColorBrush x:Key="StatusCancelBrush"  Color="#E8A000"/>
        <SolidColorBrush x:Key="NotificationBadgeBrush" Color="#C42B1C"/>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="Padding"           Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ✅ NEW: GLOBAL SPACING SYSTEM (NON-DESTRUCTIVE) -->

        <!-- Simulates Spacing="8" for vertical layouts -->
        <Style x:Key="Spacing8StackPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Apply to children when needed -->
        <Style x:Key="Spacing8Child" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Consistent label spacing -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Consistent textbox layout -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Horizontal button spacing -->
        <Style x:Key="HorizontalButtonSpacing" TargetType="Button">
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Header            -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Automation Banner -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Config Panels     -->
            <RowDefinition Height="*"/>     <!-- Row 3: DataGrid          -->
            <RowDefinition Height="Auto"/>  <!-- Row 4: Footer            -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             HEADER
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/HashDash.png"
                           Width="60" Height="60"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HashDash"
               FontSize="20"
               FontWeight="SemiBold"/>
                       <TextBlock Text="{local:VersionExtension}"
               FontSize="11"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="&#xE7F8;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding ComputerName}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="14"/>

                    <TextBlock Text=" │ " FontSize="14" Margin="12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Text="{Binding CurrentDateTime}"
                               FontSize="14" VerticalAlignment="Center"/>

                    <TextBlock Text=" │ " FontSize="14" Margin="12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <ToggleButton IsChecked="{Binding AutomationEnabled, Mode=OneWay}"
                                  Click="BtnAutomation_Click"
                                  MinWidth="160"
                                  Width="Auto"
                                  Height="40"
                                  Margin="0,0,8,0"
                                  Padding="12,0"
                                  ToolTip="Toggle Automation Mode">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background"      Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                <Setter Property="BorderBrush"     Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutomationEnabled}" Value="True">
                                        <Setter Property="Background"  Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <Setter Property="Background"  Value="{StaticResource StatusWarningBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Automation OFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AutomationEnabled}" Value="True">
                                                <Setter Property="Text"       Value="Automation ON"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                <Setter Property="Text"       Value="Processing..."/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ToggleButton>

                    <Button ToolTip="Notifications"
                            Command="{Binding ShowNotificationsCommand}"
                            Width="40" Height="40" Margin="0,0,4,0">
                        <Grid>
                            <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       Text="&#xEA8F;" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource NotificationBadgeBrush}"
                                    CornerRadius="8"
                                    MinWidth="20" Height="20"
                                    Padding="4,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-8,-8,0"
                                    Visibility="{Binding UnreadNotificationCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationCount}"
                                           Foreground="White"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button ToolTip="Capture Screenshot"
                            Click="BtnScreenshot_Click"
                            IsEnabled="{Binding IsUiEnabled}"
                            Width="40" Height="40" Margin="0,0,4,0">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xE91B;" FontSize="16"/>
                    </Button>

                    <Button ToolTip="Detect Duplicate Files"
                            Command="{Binding DetectDuplicatesCommand}"
                            Width="40" Height="40" Margin="0,0,4,0">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xE8F1;" FontSize="16"/>
                    </Button>

                    <Button ToolTip="Settings"
                            Command="{Binding OpenSettingsCommand}"
                            Width="40" Height="40" Margin="0,0,4,0">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xE713;" FontSize="16"/>
                    </Button>

                    <Button ToolTip="Help"
                            Click="BtnHelp_Click"
                            Width="40" Height="40">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xE897;" FontSize="16"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="About"             Click="MenuAbout_Click"/>
                                <MenuItem Header="User Manual"       Click="MenuUserManual_Click"/>
                                <MenuItem Header="Change Log"        Click="MenuChangeLog_Click"/>
                                <Separator/>
                                <MenuItem Header="View Process Logs" Click="MenuLogs_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             AUTOMATION BANNER
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="20,0,20,12"
                CornerRadius="8"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"  Value="Collapsed"/>
                    <Setter Property="Background"  Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowAutomationBanner}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=COMPLETED SUCCESSFULLY}">
                            <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=FAILED}">
                            <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=CANCELLED}">
                            <Setter Property="BorderBrush" Value="{StaticResource StatusCancelBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=WITH WARNINGS}">
                            <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>    <!-- Accent stripe -->
                    <ColumnDefinition Width="12"/>   <!-- Gap           -->
                    <ColumnDefinition Width="Auto"/> <!-- Icon          -->
                    <ColumnDefinition Width="12"/>   <!-- Gap           -->
                    <ColumnDefinition Width="*"/>    <!-- Text          -->
                    <ColumnDefinition Width="Auto"/> <!-- Dismiss       -->
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource StatusWarningBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=COMPLETED SUCCESSFULLY}">
                                    <Setter Property="Background" Value="{StaticResource StatusSuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=FAILED}">
                                    <Setter Property="Background" Value="{StaticResource StatusErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=CANCELLED}">
                                    <Setter Property="Background" Value="{StaticResource StatusCancelBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <TextBlock Grid.Column="2"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"       Value="&#xE7BA;"/>
                            <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=COMPLETED SUCCESSFULLY}">
                                    <Setter Property="Text"       Value="&#xE73E;"/>
                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=FAILED}">
                                    <Setter Property="Text"       Value="&#xE783;"/>
                                    <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=CANCELLED}">
                                    <Setter Property="Text"       Value="&#xE711;"/>
                                    <Setter Property="Foreground" Value="{StaticResource StatusCancelBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringContainsConverter}, ConverterParameter=WITH}">
                                    <Setter Property="Text"       Value="&#xE7BA;"/>
                                    <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,12">
                    <TextBlock Text="{Binding AutomationStatusText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutomationEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Watching for: "/>
                        <Run Text="{Binding TriggerFilePattern, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="5"
                        Content="✕ Dismiss"
                        Width="90" Height="32"
                        Margin="12,0,12,0"
                        Command="{Binding DismissAutomationMessageCommand}"
                        VerticalAlignment="Center"
                        FontSize="12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AutomationEnabled}" Value="False"/>
                                        <Condition Binding="{Binding AutomationStatusMessage, Converter={StaticResource StringIsNotEmptyConverter}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             MAIN CONFIGURATION PANELS
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              Margin="20,0,20,16"
              IsEnabled="{Binding IsUiEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Case Information -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Case Information"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Border Grid.Row="1"
                            Height="1"
                            Margin="0,8,0,0"
                            Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Examiner Name" FontSize="14" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Height="40"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 MaxLength="100"
                                 IsEnabled="{Binding AreFieldsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                 Text="{Binding ExaminerName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5">
                        <TextBlock Text="Lab Case Reference" FontSize="14" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Height="40"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 MaxLength="100"
                                 IsEnabled="{Binding AreFieldsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                 Text="{Binding LabCaseRef, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="7">
                        <TextBlock Text="Exhibit Reference" FontSize="14" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Height="40"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 MaxLength="100"
                                 IsEnabled="{Binding AreFieldsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                 Text="{Binding ExhibitRef, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Data Copying / Verification -->
            <Border Grid.Column="2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title row with checkboxes on the right -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Data Copying / Verification"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="MD5"
                                      IsChecked="{Binding Md5Enabled}"
                                      Margin="0,0,2,0"
                                      FontSize="14"
                                      IsEnabled="{Binding AreFieldsLocked, Converter={StaticResource InverseBooleanConverter}}"/>
                            <CheckBox Content="SHA-256"
                                      IsChecked="{Binding Sha256Enabled}"
                                      FontSize="14"
                                      IsEnabled="{Binding AreFieldsLocked, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Height="1"
                            Margin="0,8,0,0"
                            Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

                    <!-- SOURCE PATH -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" Style="{StaticResource FormLabelStyle}">
                                <Run Text="Source Path"/>
                                <Run Text=" │ "  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Run Text="{Binding SourceDriveLabel, Mode=OneWay}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </TextBlock>
                            <TextBox Height="40"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     ToolTip="{Binding SourcePath}"
                                     IsEnabled="{Binding AreFieldsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                     Text="{Binding SourcePath, Mode=OneWay}"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                ToolTip="Browse Source Folder"
                                Command="{Binding BrowseFolderCommand}"
                                Width="40" Height="40"
                                VerticalAlignment="Bottom">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"/>
                        </Button>

                        <Button Grid.Column="4"
                                ToolTip="Connect MTP Device (phone, camera, drone controller)"
                                Command="{Binding ConnectMtpDeviceCommand}"
                                Width="40" Height="40"
                                VerticalAlignment="Bottom">
                            <TextBlock Text="&#xE8EA;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"/>
                        </Button>
                    </Grid>

                    <!-- DESTINATION PATH -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" Style="{StaticResource FormLabelStyle}">
                                <Run Text="Destination Path"/>
                                <Run Text=""
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Run Text=" │ "
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Run Text="{Binding DestinationDriveLabel, Mode=OneWay}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </TextBlock>
                            <TextBox Height="40"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     ToolTip="{Binding DestinationPath}"
                                     IsEnabled="{Binding AreFieldsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                     Text="{Binding DestinationPath, Mode=OneWay}"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                ToolTip="Browse Destination Folder"
                                Command="{Binding BrowseDestinationCommand}"
                                Width="40" Height="40"
                                VerticalAlignment="Bottom">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"/>
                        </Button>
                    </Grid>

                    <!-- SECONDARY DESTINATION PATH -->
                    <Grid Grid.Row="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--
                        Dimmed at 40% opacity when no secondary path is set,
                        full opacity once a path is configured.
                        The browse button (Col 2) is always at full opacity.
                        -->
                        <StackPanel Grid.Column="0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SecondaryDestinationPath,
                                                     Converter={StaticResource StringIsNotEmptyConverter}}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontSize="14" Style="{StaticResource FormLabelStyle}">
                                <Run Text="Secondary Destination Path"/>
                                <Run Text=""
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Run Text=" │ "
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Run Text="{Binding SecondaryDestinationDriveLabel, Mode=OneWay}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </TextBlock>
                            <TextBox Height="40"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     ToolTip="{Binding SecondaryDestinationPath}"
                                     IsEnabled="{Binding AreFieldsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                     Text="{Binding SecondaryDestinationPath, Mode=OneWay}"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                ToolTip="Browse Secondary Destination Folder"
                                Command="{Binding BrowseSecondaryDestinationCommand}"
                                Width="40" Height="40"
                                VerticalAlignment="Bottom">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             DATAGRID SECTION
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3"
              Margin="20,0,20,16"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOOLBAR: Search (left) | Action buttons (right) -->
            <Grid Grid.Row="0" Margin="8,8,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Search bar    -->
                    <ColumnDefinition Width="*"/>     <!-- Flexible gap  -->
                    <ColumnDefinition Width="Auto"/>  <!-- Action buttons-->
                </Grid.ColumnDefinitions>

                <!--
                SEARCH BAR
                ─────────────────────────────────────────────────────────────
                Binds to SearchText in the ViewModel. The ViewModel exposes
                a FilesView (ICollectionView) whose Filter checks all visible
                columns. The DataGrid below binds to FilesView, not Files.
                ─────────────────────────────────────────────────────────────
                -->
                <Grid Grid.Column="0" Width="260" VerticalAlignment="Center">
                    <TextBox Height="40"
                             Padding="36,0,12,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search across all columns"/>

                    <!-- Search icon — decorative, non-interactive -->
                    <TextBlock Text="&#xE721;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="15"
                               Margin="10,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!--
                    Placeholder — visible only while SearchText is empty.
                    StringIsNotEmptyConverter returns True when string has
                    content, so Value="False" means the box is empty.
                    -->
                    <TextBlock Text="Search files..."
                               Margin="36,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText, Converter={StaticResource StringIsNotEmptyConverter}}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- STATUS FILTER -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Status:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="13"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding StatusFilter}"
                              Width="160" Height="36"
                              VerticalContentAlignment="Center"/>

                    <!-- VIEW MODE: plain list | directory tree | thumbnails -->
                    <Border Width="1" Height="24" Margin="16,0,12,0"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                    <RadioButton GroupName="FileViewMode"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 IsChecked="{Binding IsListView}"
                                 ToolTip="List view — every file in one table"
                                 Width="40" Height="36">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16"/>
                    </RadioButton>
                    <RadioButton GroupName="FileViewMode"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 IsChecked="{Binding IsDirectoryView}"
                                 ToolTip="Directory view — folder structure (and Photos albums for iPhones) with per-folder totals"
                                 Width="40" Height="36" Margin="4,0,0,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16"/>
                    </RadioButton>
                    <RadioButton GroupName="FileViewMode"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 IsChecked="{Binding IsThumbnailView}"
                                 ToolTip="Thumbnail view"
                                 Width="40" Height="36" Margin="4,0,0,0">
                        <TextBlock Text="&#xE80A;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16"/>
                    </RadioButton>
                </StackPanel>

                <!-- ACTION BUTTONS (right-aligned) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Export Detailed Log"
                            Command="{Binding ExportDetailedLogCommand}"
                            Width="40" Height="40">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xE7C3;" FontSize="16"/>
                    </Button>
                    <Button ToolTip="Export to CSV"
                            Command="{Binding ExportCsvCommand}"
                            Width="40" Height="40" Margin="4,0,0,0">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xF0E3;" FontSize="16"/>
                    </Button>
                    <Button ToolTip="Export to PDF"
                            Command="{Binding ExportPdfCommand}"
                            Width="40" Height="40" Margin="4,0,0,0">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xEA90;" FontSize="16"/>
                    </Button>
                    <Button ToolTip="Clear all files from table"
                            Command="{Binding ClearCommand}"
                            Width="40" Height="40" Margin="4,0,0,0">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   Text="&#xE74D;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- LIST VIEW -->
            <Border Grid.Row="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid x:Name="dgFiles"
          ItemsSource="{Binding FilesView}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          SelectionUnit="Cell"
          SelectionMode="Extended"
          ClipboardCopyMode="IncludeHeader"
          HeadersVisibility="All"
          RowHeight="40"
          ColumnHeaderHeight="40"
          GridLinesVisibility="All"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          ColumnWidth="SizeToCells"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling">

                    <!-- Right-click any column header to toggle visibility.
                         BasedOn preserves the Fluent/WinUI theme style. -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <EventSetter Event="MouseRightButtonUp" Handler="ColumnHeader_RightClick"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="Auto" CanUserResize="True">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Padding="8"
                          IsChecked="{Binding DataContext.IsAllSelected,
                                      RelativeSource={RelativeSource AncestorType=Window},
                                      Mode=TwoWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Padding="8"
                          IsChecked="{Binding IsSelected, Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="#"
                        Binding="{Binding Id}"
                        Width="Auto"
                        IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="Status"
                            Width="Auto"
                            SortMemberPath="CopyStatus"
                            IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CopyStatus}"
                                               
                           Foreground="{Binding StatusBrush}"
                           HorizontalAlignment="Center"
                                               Padding="8"
                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Filename"
                        Binding="{Binding FileName}"
                        Width="Auto"
                        MinWidth="280"
                                             ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="Size"
    Binding="{Binding SizeDisplay}"
    SortMemberPath="FileSizeBytes"
    Width="Auto"
                                             ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="File Date"
    Binding="{Binding FileDate}"
    SortMemberPath="FileDateValue"
                        Width="Auto"
                        MinWidth="110"
                                             ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="Transfer / Verify Date"
    Binding="{Binding TransferDate}"
    SortMemberPath="TransferDateValue"
                        Width="Auto"
                        MinWidth="110"
                                             ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="Photos Albums"
                        Binding="{Binding PhotoAlbumsDisplay, Mode=OneWay}"
                        Width="Auto"
                        MaxWidth="360"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="Saved By App"
                        Binding="{Binding SavedByApp, Mode=OneWay}"
                        Width="Auto"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="Library Role"
                        Binding="{Binding LibraryRole, Mode=OneWay}"
                        Width="Auto"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="Path"
                        Binding="{Binding FullPath}"
                        Width="Auto"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"
                        Visibility="Collapsed"/>

                        <DataGridTextColumn Header="SHA-256 (Source)"
                        Binding="{Binding Sha256}"
                        Width="Auto"
                        MinWidth="470"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="SHA-256 (Dest)"
                        Binding="{Binding DestSha256}"
                        Width="Auto"
                        MinWidth="470"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"/>

                        <DataGridTextColumn Header="SHA-256 (Secondary)"
                        Binding="{Binding SecondaryDestSha256}"
                        Width="Auto"
                        MinWidth="470"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"
                        Visibility="Collapsed"/>

                        <DataGridTextColumn Header="MD5 (Source)"
                        Binding="{Binding Md5}"
                        Width="Auto"
                        MinWidth="250"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"
                        Visibility="Collapsed"/>

                        <DataGridTextColumn Header="MD5 (Dest)"
                        Binding="{Binding DestMd5}"
                        Width="Auto"
                        MinWidth="250"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"
                        Visibility="Collapsed"/>

                        <DataGridTextColumn Header="MD5 (Secondary)"
                        Binding="{Binding SecondaryDestMd5}"
                        Width="Auto"
                        MinWidth="250"
                        ElementStyle="{StaticResource CellTextStyle}"
                        IsReadOnly="True"
                        Visibility="Collapsed"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- DIRECTORY VIEW: folder / album tree (left) | files under the selected node (right) -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsDirectoryView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" MinWidth="240"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <TreeView x:Name="tvFolders"
                              ItemsSource="{Binding FolderTree}"
                              SelectedItemChanged="TvFolders_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsNodeSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              IsThreeState="True"
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              ToolTip="Select / deselect every file under this folder"/>
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="14"
                                               Margin="2,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding TotalFilesDisplay, Mode=OneWay}"/><Run Text=" files · "/><Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding SelectedFolderTitle}"
                               FontWeight="SemiBold"
                               Margin="4,4,0,8"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Grid.Row="1"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <DataGrid ItemsSource="{Binding FolderFilesView}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionUnit="Cell"
                                  SelectionMode="Extended"
                                  ClipboardCopyMode="IncludeHeader"
                                  HeadersVisibility="Column"
                                  RowHeight="36"
                                  ColumnHeaderHeight="40"
                                  GridLinesVisibility="All"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="CopyStatus" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CopyStatus}" Foreground="{Binding StatusBrush}"
                                                       Padding="8" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" MinWidth="220"
                                                    ElementStyle="{StaticResource CellTextStyle}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" SortMemberPath="FileSizeBytes"
                                                    ElementStyle="{StaticResource CellTextStyle}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="File Date" Binding="{Binding FileDate}" SortMemberPath="FileDateValue"
                                                    ElementStyle="{StaticResource CellTextStyle}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Photos Albums" Binding="{Binding PhotoAlbumsDisplay, Mode=OneWay}" MaxWidth="320"
                                                    ElementStyle="{StaticResource CellTextStyle}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Saved By App" Binding="{Binding SavedByApp, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CellTextStyle}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Library Role" Binding="{Binding LibraryRole, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CellTextStyle}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding FullPath}"
                                                    ElementStyle="{StaticResource CellTextStyle}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="SHA-256 (Source)" Binding="{Binding Sha256}"
                                                    ElementStyle="{StaticResource CellTextStyle}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- THUMBNAIL VIEW: rows of tiles; rows are virtualised so only visible tiles load images -->
            <Border Grid.Row="1"
                    x:Name="thumbnailHost"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    SizeChanged="ThumbnailHost_SizeChanged"
                    Visibility="{Binding IsThumbnailView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox ItemsSource="{Binding ThumbnailRows}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="168" Height="204" Margin="4" CornerRadius="6"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                Loaded="ThumbnailTile_Loaded"
                                                DataContextChanged="ThumbnailTile_DataContextChanged">
                                            <Border.ToolTip>
                                                <StackPanel MaxWidth="420">
                                                    <TextBlock Text="{Binding Entry.FullPath}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Entry.SizeDisplay}"/>
                                                    <TextBlock Text="{Binding Entry.PhotoAlbumsDisplay}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Entry.LibraryRole}"/>
                                                </StackPanel>
                                            </Border.ToolTip>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="160"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="40"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <Image Source="{Binding Image}" Stretch="Uniform" Margin="4"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <CheckBox IsChecked="{Binding Entry.IsSelected, Mode=TwoWay}"
                                                          MinWidth="0"
                                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                                          Margin="6,4,0,0"/>
                                                <StackPanel Grid.Row="1" Margin="8,2,8,4">
                                                    <TextBlock Text="{Binding Entry.FileName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Entry.CopyStatus}" FontSize="11"
                                                               Foreground="{Binding Entry.StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             FOOTER
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <!-- Left:   Time Remaining    -->
                    <ColumnDefinition Width="*"/>
                    <!-- Centre: Progress bar      -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right:  Buttons           -->
                </Grid.ColumnDefinitions>

                <!-- Left: Time Remaining - static, never moves -->
                <!--<StackPanel Grid.Column="0"
                VerticalAlignment="Center"
                Visibility="{Binding IsCancelEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding TransferRateText}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <TextBlock Text="{Binding EtaText}"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>-->

                <!-- Centre: Progress bar and current filename -->
                <StackPanel Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Margin="16,0"
                Visibility="{Binding IsCancelEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Height="6"
                     Value="{Binding CurrentFileProgress}"
                     Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CurrentFileText}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Right: Cancel + Run - always anchored to the right edge -->
                <StackPanel Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                    <Button Content="Cancel"
                Width="100" Height="40" Margin="0,0,8,0"
                FontSize="14"
                Visibility="{Binding IsCancelEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                Command="{Binding CancelCommand}"/>
                    <Button Style="{DynamicResource AccentButtonStyle}"
                Content="Run"
                Width="100" Height="40"
                FontSize="14"
                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
                Command="{Binding RunCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
