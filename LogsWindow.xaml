<Window x:Class="HashDash.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Log History"
        Width="1200"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="800"
        MinHeight="500"
   
        FontFamily="Segoe UI Variable"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Process Log History" 
                       FontSize="22" 
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="txtRecordCount"
                       FontSize="12" 
                       Foreground="Gray"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Filter Controls -->
        <Border Grid.Row="2"
   
                Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="From:"
                           VerticalAlignment="Center"
                           FontSize="13"/>

                <DatePicker Grid.Column="2"
                            x:Name="dpStartDate"
                            Height="32"
                            VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           Text="To:"
                           VerticalAlignment="Center"
                           FontSize="13"/>

                <DatePicker Grid.Column="6"
                            x:Name="dpEndDate"
                            Height="32"
                            VerticalContentAlignment="Center"/>

                <!-- Search box — uses the flexible * column -->
                <Grid Grid.Column="7" Margin="12,0">
                    <TextBox x:Name="txtSearch"
                             Height="32"
                             Padding="32,0,12,0"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"
                             ToolTip="Search by examiner, case ref, exhibit, computer, drive label, or status"/>
                    <TextBlock Text="&#xE721;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="14"
                               Margin="10,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Search logs..."
                               Margin="32,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="8"
                            Orientation="Horizontal">
                    <Button Content="Apply Filter"
                            Width="110"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="BtnFilter_Click"
                            FontSize="12"/>
                    <Button Content="Reset"
                            Width="80"
                            Height="32"
                            Click="BtnReset_Click"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <!-- DataGrid -->
        <DataGrid Grid.Row="4"
          x:Name="dgLogs"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True"
          HeadersVisibility="All"
          RowHeight="40"
          ColumnHeaderHeight="44"
          GridLinesVisibility="All"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          AlternatingRowBackground="#F9F9F9">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Start Date/Time" 
                            Binding="{Binding StartTimeDisplay}" 
                            Width="155"
                            FontSize="12"/>

                <DataGridTextColumn Header="End Date/Time" 
                            Binding="{Binding EndTimeDisplay}" 
                            Width="155"
                            FontSize="12"/>

                <DataGridTextColumn Header="Examiner" 
                            Binding="{Binding ExaminerName}" 
                            Width="150"
                            FontSize="12"/>

                <DataGridTextColumn Header="Case Ref" 
                            Binding="{Binding LabCaseRef}" 
                            Width="120"
                            FontSize="12"/>

                <DataGridTextColumn Header="Exhibit Ref" 
                            Binding="{Binding ExhibitRef}" 
                            Width="120"
                            FontSize="12"/>

                <DataGridTextColumn Header="Computer" 
                            Binding="{Binding ComputerName}" 
                            Width="120"
                            FontSize="12"/>

                <DataGridTextColumn Header="Source Label" 
                            Binding="{Binding SourceDriveLabel}" 
                            Width="130"
                            FontSize="12"/>

                <DataGridTextColumn Header="Dest Label" 
                            Binding="{Binding DestinationDriveLabel}" 
                            Width="130"
                            FontSize="12"/>

                <DataGridTextColumn Header="Files" 
                            Binding="{Binding FileCount}" 
                            Width="60"
                            FontSize="12"/>

                <DataGridTextColumn Header="Total Size" 
                            Binding="{Binding TotalSizeDisplay}" 
                            Width="100"
                            FontSize="12"/>

                <DataGridTextColumn Header="Duration" 
                            Binding="{Binding DurationDisplay}" 
                            Width="80"
                            FontSize="12"/>

                <DataGridTextColumn Header="Status" 
                            Binding="{Binding Status}" 
                            Width="90"
                            FontSize="12">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter Property="Foreground" Value="Orange"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Mode" 
                            Binding="{Binding ModeDisplay}" 
                            Width="100"
                            FontSize="12">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutomationMode}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0078D4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="6" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Export to CSV"
                    Width="140"
                    Height="40"
                    Margin="0,0,12,0"
                    Click="BtnExportCsv_Click"
                    FontSize="13"/>
            <Button Content="Close"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="120"
                    Height="40"
                    Click="BtnClose_Click"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>