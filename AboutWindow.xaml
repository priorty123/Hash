<Window x:Class="HashDash.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HashDash" 
        Title="About HashDash"
        Width="500"
        Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Logo -->
        <Border Grid.Row="0" 
                Padding="40,32,40,24"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="/HashDash.png" 
                       Width="80" 
                       Height="80" 
                       Margin="0,0,0,16"/>

                <TextBlock Text="HashDash" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{local:VersionExtension}"
                           FontSize="14" 
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="40,24">
            <StackPanel>

                <!-- Description -->
                <TextBlock Text="Professional Data Transfer &amp; Verification Utility"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock TextWrapping="Wrap"
                           FontSize="13"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    HashDash is a professional utility for copying and verifying data with confidence. It confirms that every file arrives at its destination exactly as it left the source, and keeps a clear record of every transfer for accountability and audit purposes. Designed to align with NIST guidelines and ISO 17025 quality standards.
                </TextBlock>

                <!-- Copyright -->
                <Border BorderThickness="0,1,0,0" 
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Padding="0,16,0,0"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="13" Margin="0,0,0,4">
                            <Run Text="© 2026 " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Run Text="Adeel Khan" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="All rights reserved." 
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- System Information -->
                <TextBlock Text="System Information" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="Framework:" 
                               FontSize="12" 
                               Margin="0,0,12,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text=".NET 10.0" 
                               FontSize="12" 
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="Platform:" 
                               FontSize="12" 
                               Margin="0,0,12,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="Windows 10/11 (x64)" 
                               FontSize="12" 
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="Build:" 
                               FontSize="12" 
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                               Text="Release" 
                               FontSize="12"/>
                </Grid>

                <!-- Features -->
                <TextBlock Text="Key Features" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Margin="0,8,0,12"/>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="• Copy files and verify they transferred correctly"
                               FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• Copy to a primary and secondary location in one run"
                               FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• Automatic mode — starts when a trigger file is detected"
                               FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• Full transfer history with searchable logs"
                               FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• PDF, CSV, and detailed log export"
                               FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• Duplicate file detection"
                               FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• Customisable column layout — show only what you need"
                               FontSize="12"/>
                </StackPanel>

                <!-- License -->
                <Border BorderThickness="0,1,0,0" 
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Padding="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="License" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="This software is provided as-is without warranty of any kind. For professional use."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Close Button -->
        <Border Grid.Row="2" 
                Padding="40,16"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Button Content="Close" 
                    Width="120" 
                    Height="36"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    Click="BtnClose_Click"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </Border>
    </Grid>
</Window>